universe = vanilla
tree = ntmix
year = PbPb23
fom = auc
sample_output_dir = tmva_outputs/$(tree)/$(year)_$(fom)
use_optimized = 1

initialdir = /eos/user/h/hmarques/Analysis_CODES/selectionER/ML_selection/methods/ML_tmva
executable = /eos/user/h/hmarques/Analysis_CODES/selectionER/ML_selection/methods/ML_tmva/run_tmva.sh
arguments = -l -b -q TMVA_train.C
# The scan summaries are read from the /eos mount of the worker: condor on EOS cannot transfer a folder in.
environment = "ML_CASE=$(tree)/$(year) ML_FOM=$(fom) ML_USE_OPTIMIZED=$(use_optimized) ML_OPTIMIZATION_DIR=$(initialdir)/$(sample_output_dir)/optimization ML_USE_XROOTD=1"

transfer_input_files = TMVA_train.C, TMVA_config.h, TMVA_common.h, ml_settings.h
transfer_output_files = tmva_outputs
output = condor_logs/train_$(tree)_$(year)_$(fom)_$(ClusterId).out
error = condor_logs/train_$(tree)_$(year)_$(fom)_$(ClusterId).err
log = condor_logs/train_$(tree)_$(year)_$(fom)_$(ClusterId).log

getenv = False
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 1
request_memory = 10 GB
request_disk = 4 GB
requirements = (OpSysAndVer == "AlmaLinux9")
+JobFlavour = "tomorrow"

queue 1
